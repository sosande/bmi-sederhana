<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefWidth="320.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bmi.BmiController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Kalkulator BMI">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label text="Berat badan (kg)" />
      <TextField fx:id="txtBerat" onAction="#hitung" promptText="contoh: 65" />
      <Label text="Tinggi badan (cm)" />
      <TextField fx:id="txtTinggi" onAction="#hitung" promptText="contoh: 170" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#hitung" prefWidth="90.0" text="Hitung" />
            <Button mnemonicParsing="false" onAction="#reset" prefWidth="90.0" text="Reset" />
         </children>
      </HBox>
      <Label fx:id="lblHasil" text="Hasil akan tampil di sini" wrapText="true">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
   </children>
</VBox>
